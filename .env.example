# Copie para .env e preencha. Nunca versione o .env.
# Valores de host abaixo servem para rodar FORA do Docker (venv local);
# dentro do Docker Compose, POSTGRES_HOST/REDIS_HOST/MINIO_ENDPOINT são
# sobrescritos para os nomes dos containers na rede network_public.

# --- Django ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=false
# Mantenha 127.0.0.1 (usado pelo healthcheck do container web).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ex.: https://gohub.exemplo.com.br (separados por vírgula)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# --- E-mail (redefinição de senha) ---
# Vazio: console (com DJANGO_DEBUG=true) ou SMTP (produção).
EMAIL_BACKEND=
EMAIL_HOST=smtp.exemplo.com.br
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Use TLS (porta 587) OU SSL (porta 465), nunca os dois.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=GoHub <nao-responda@exemplo.com.br>
# Validade do link de redefinição, em segundos.
PASSWORD_RESET_TIMEOUT=3600

# --- Postgres ---
POSTGRES_DB=gohub
POSTGRES_USER=gohub
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis (broker do Celery) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=troque-esta-senha
REDIS_DB=0
# Banco lógico do cache (contadores do rate limit); diferente do REDIS_DB do Celery.
REDIS_CACHE_DB=1

# --- Leads (captação pública e LGPD) ---
# Versão da política de privacidade aceita no formulário (até 20 caracteres).
POLITICA_PRIVACIDADE_VERSAO=1.0
# Link da política exibido no formulário (https:// ou caminho iniciado por /). Vazio oculta o link.
POLITICA_PRIVACIDADE_URL=
# Envios por IP no formulário e na API de captação, somados. Ex.: 10/min, 100/hour.
LEADS_PUBLICO_TAXA=10/min
# Proxies confiáveis na frente do Django (0 = ignora X-Forwarded-For e usa o IP da conexão).
# Em produção, com proxy reverso, use o número real de proxies: com 0, todos os visitantes
# dividem o limite do IP do proxy e um único abusador bloqueia o formulário para todos.
LEADS_PROXY_SALTOS=0
# IPs ou redes CIDR dos proxies (obrigatório se LEADS_PROXY_SALTOS > 0). Ex.: 172.18.0.0/16
LEADS_PROXY_CONFIAVEIS=

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=troque
MINIO_SECRET_KEY=troque
MINIO_USE_SSL=false
MINIO_REGION=

# --- Gunicorn (produção) ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# --- Imagem (usado pelo docker-compose.prod.yml) ---
# GOHUB_IMAGE=seu-usuario-dockerhub/gohub
# GOHUB_TAG=0.1.0
